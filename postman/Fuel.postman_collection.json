  "item": [
    {
      "name": "Predict cities",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Returns HTTP 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Matches the city-prediction schema\", function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.suggestions).to.be.an(\"array\").that.is.not.empty;",
              "    body.suggestions.forEach(function (suggestion) {",
              "        pm.expect(suggestion).to.include.all.keys(\"label\", \"city\", \"state\", \"state_name\", \"coordinates\");",
              "        pm.expect(suggestion.coordinates).to.be.an(\"array\").with.lengthOf(2);",
              "    });",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/locations/?q=Fort%20S%2C%20AR",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "locations",
            ""
          ],
          "query": [
            {
              "key": "q",
              "value": "Fort S, AR"
            }
          ]
        },
        "description": "Returns up to eight local city predictions for the route form."
      },
      "response": []
    },
    {
      "name": "Create fuel plan",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Returns HTTP 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Matches the fuel-plan response schema\", function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body).to.include.all.keys(\"start\", \"finish\", \"route\", \"vehicle\", \"fuel_stops\", \"total_gallons\", \"total_fuel_cost\", \"currency\", \"attribution\", \"assumptions\");",
              "    pm.expect(body.start).to.include.all.keys(\"label\", \"coordinates\");",
              "    pm.expect(body.finish).to.include.all.keys(\"label\", \"coordinates\");",
              "    pm.expect(body.start.coordinates).to.be.an(\"array\").with.lengthOf(2);",
              "    pm.expect(body.finish.coordinates).to.be.an(\"array\").with.lengthOf(2);",
              "    pm.expect(body.route).to.include.all.keys(\"distance_miles\", \"duration_hours\", \"geometry\");",
              "    pm.expect(body.route.geometry.type).to.eql(\"LineString\");",
              "    pm.expect(body.route.geometry.coordinates).to.be.an(\"array\").that.is.not.empty;",
              "    pm.expect(body.vehicle).to.deep.equal({ mpg: 10, max_range_miles: 500, tank_capacity_gallons: 50 });",
              "    pm.expect(body.fuel_stops).to.be.an(\"array\").that.is.not.empty;",
              "    pm.expect(body.total_gallons).to.be.a(\"number\").and.to.be.above(0);",
              "    pm.expect(body.total_fuel_cost).to.be.a(\"number\").and.to.be.above(0);",
              "    pm.expect(body.currency).to.eql(\"USD\");",
              "    pm.expect(body.assumptions).to.be.an(\"array\");",
              "});",
              "",
              "pm.test(\"Fuel stops match the current item schema\", function () {",
              "    const stops = pm.response.json().fuel_stops;",
              "    stops.forEach(function (stop) {",
              "        pm.expect(stop).to.include.all.keys(\"station_id\", \"name\", \"address\", \"city\", \"state\", \"coordinates\", \"location_accuracy\", \"price_per_gallon\", \"route_mile\", \"estimated_detour_miles\", \"gallons\", \"cost\");",
              "        pm.expect(stop.coordinates).to.be.an(\"array\").with.lengthOf(2);",
              "        pm.expect(stop.price_per_gallon).to.be.a(\"number\").and.to.be.above(0);",
              "        pm.expect(stop.gallons).to.be.a(\"number\").and.to.be.above(0);",
              "        pm.expect(stop.cost).to.be.a(\"number\").and.to.be.above(0);",
              "    });",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"Fort Smith, AR\",\n  \"finish\": \"Mount Jackson, VA\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/v1/routes/fuel-plan/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "routes",
            "fuel-plan",
            ""
          ]
        },
        "description": "Returns route GeoJSON, vehicle assumptions, optimized fuel purchases, and total estimated fuel cost."
      },
      "response": []
    },
