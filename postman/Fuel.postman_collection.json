              "",
              "pm.test(\"Returns the validation error envelope\", function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.error.code).to.eql(\"validation_error\");",
              "    pm.expect(body.error.message).to.be.a(\"string\");",
              "    pm.expect(body.error.fields.start).to.be.a(\"string\");",
              "});"
            ]
          }
        }
      ],
